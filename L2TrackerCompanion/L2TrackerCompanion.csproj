<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>L2TrackerCompanion</RootNamespace>
    <AssemblyName>L2TrackerCompanion</AssemblyName>
    <Version>1.0.0</Version>
    <Product>L2 Tracker Companion</Product>
    <!-- e_sqlite3.dll (and any other native assets) must extract from the
         single-file bundle at runtime; without this, session.db fails to open. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Assets/app.ico is the frontend's favicon.svg (the BrandMark arc) re-cut
         to icon sizes; Assets/app-icon.svg is kept as its source. The window
         needs no Icon of its own: with no Icon set, WPF falls back to the
         executable's icon, which is this one. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\L2TrackerCompanion.Capture\L2TrackerCompanion.Capture.csproj" />
    <ProjectReference Include="..\L2TrackerCompanion.Ocr\L2TrackerCompanion.Ocr.csproj" />
    <ProjectReference Include="..\L2TrackerCompanion.Session\L2TrackerCompanion.Session.csproj" />
    <ProjectReference Include="..\L2TrackerCompanion.Api\L2TrackerCompanion.Api.csproj" />
  </ItemGroup>

</Project>
