<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>L2TrackerCompanion</RootNamespace>
    <AssemblyName>L2TrackerCompanion</AssemblyName>
    <Version>1.0.2</Version>
    <Product>L2 Tracker Companion</Product>
    <!-- Program.cs owns startup (VelopackApp.Build().Run() must run before the
         WPF Application is constructed), not App.xaml's StartupUri. -->
    <StartupObject>L2TrackerCompanion.Program</StartupObject>
    <!-- Assets/app.ico is the frontend's favicon.svg (the BrandMark arc) re-cut
         to icon sizes; Assets/app-icon.svg is kept as its source. It is also a
         Resource below, because the window's Icon is this same mark with the
         tracking-status dot badged onto it (StatusDotIcon) rather than the
         plain executable icon WPF would fall back to. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.11" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\L2TrackerCompanion.Capture\L2TrackerCompanion.Capture.csproj" />
    <ProjectReference Include="..\L2TrackerCompanion.Ocr\L2TrackerCompanion.Ocr.csproj" />
    <ProjectReference Include="..\L2TrackerCompanion.Session\L2TrackerCompanion.Session.csproj" />
    <ProjectReference Include="..\L2TrackerCompanion.Api\L2TrackerCompanion.Api.csproj" />
  </ItemGroup>

</Project>
