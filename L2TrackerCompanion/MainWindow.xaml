<Window x:Class="L2TrackerCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="L2 Tracker Companion"
        Height="820"
        Width="800">
    <Grid Margin="16">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Top">
                <TextBlock Text="Game window"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <TextBlock x:Name="GameWindowStatusLabel"
                           Text="Checking..."
                           TextWrapping="Wrap"
                           FontFamily="Consolas"
                           FontSize="13"
                           Margin="0,0,0,16" />
                <Button x:Name="CaptureOnceButton"
                        Content="Capture once"
                        Padding="12,6"
                        HorizontalAlignment="Left"
                        Click="CaptureOnceButton_Click" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="StartStopButton"
                            Content="Start tracking"
                            Padding="12,6"
                            Click="StartStopButton_Click" />
                    <TextBlock x:Name="PollStatusLabel"
                               Text="Not tracking."
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               FontFamily="Consolas"
                               FontSize="13"
                               Margin="12,0,0,0" />
                </StackPanel>
                <Border x:Name="LiveStatusBorder"
                        Margin="0,16,0,0"
                        Padding="12"
                        BorderThickness="1"
                        BorderBrush="#30363d"
                        Background="#161b22">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Ellipse x:Name="LiveLight"
                                     Width="16"
                                     Height="16"
                                     Fill="#6e7681"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="LiveLightLabel"
                                       Text="Idle"
                                       FontWeight="SemiBold"
                                       FontSize="16"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="LiveDetailLabel"
                                   Text="No snapshot yet."
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   Margin="0,0,0,8" />
                        <TextBlock x:Name="LiveValuesLabel"
                                   Text=""
                                   TextWrapping="Wrap"
                                   FontFamily="Consolas"
                                   FontSize="13" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="CaptureStatusLabel"
                           Text=""
                           TextWrapping="Wrap"
                           FontFamily="Consolas"
                           FontSize="13"
                           Margin="0,12,0,16" />
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ParseLastButton"
                            Content="Parse last capture"
                            Padding="12,6"
                            Click="ParseLastButton_Click" />
                    <Button x:Name="ParsePngButton"
                            Content="Parse a PNG..."
                            Padding="12,6"
                            Margin="8,0,0,0"
                            Click="ParsePngButton_Click" />
                    <Button x:Name="NewSessionButton"
                            Content="New session"
                            Padding="12,6"
                            Margin="8,0,0,0"
                            Click="NewSessionButton_Click" />
                </StackPanel>
                <TextBlock x:Name="ParseStatusLabel"
                           Text=""
                           TextWrapping="Wrap"
                           FontFamily="Consolas"
                           FontSize="13"
                           Margin="0,12,0,12" />
                <TextBlock x:Name="SessionStatusLabel"
                           Text=""
                           TextWrapping="Wrap"
                           FontFamily="Consolas"
                           FontSize="13" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
