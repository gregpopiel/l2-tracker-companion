<Window x:Class="L2TrackerCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="L2 Tracker Companion"
        Icon="Assets/app.ico"
        Height="920"
        Width="800"
        Background="{StaticResource TerminalBlackBrush}"
        Foreground="{StaticResource SignalWhiteBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="{StaticResource FontSizeBody}"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <!-- Sign-in gate: the only view until GET /api/me + /api/characters accept the token. -->
        <ScrollViewer x:Name="LoginView"
                      VerticalScrollBarVisibility="Auto">
            <ContentControl MaxWidth="480"
                            Margin="24,64,24,24"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Center"
                            Style="{StaticResource BeaconPanel}">
                <StackPanel>
                    <TextBlock Text="SESSION LOG — L2 FARM TRACKER"
                               Style="{StaticResource StampText}"
                               Margin="0,0,0,10" />
                    <TextBlock Text="L2 Tracker Companion"
                               Style="{StaticResource HeadlineText}"
                               Margin="0,0,0,20" />
                    <StackPanel x:Name="GateForm">
                        <TextBlock x:Name="AuthHintLabel"
                                   Text="Paste the token from the website."
                                   Style="{StaticResource SubtleText}"
                                   Margin="0,0,0,18" />
                        <!-- The mode itself is switched on the Settings tab; this
                             row just follows the stored mode, since the API has to
                             be pointed somewhere before there is a session. -->
                        <Grid x:Name="ApiUrlRow"
                              Margin="0,0,0,10"
                              Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="API"
                                       Style="{StaticResource FieldLabelText}"
                                       Margin="0,0,12,0" />
                            <TextBox x:Name="BaseUrlBox" Grid.Column="1" />
                        </Grid>
                        <TextBlock x:Name="CustomApiLabel"
                                   Text=""
                                   Style="{StaticResource MutedText}"
                                   Margin="0,0,0,10"
                                   Visibility="Collapsed" />
                        <PasswordBox x:Name="TokenBox"
                                     Margin="0,0,0,14"
                                     KeyDown="TokenBox_KeyDown" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <Button x:Name="SignInButton"
                                    Content="Sign in"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="SignInButton_Click" />
                            <Button x:Name="RetryButton"
                                    Content="Retry with stored token"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="10,0,0,0"
                                    Visibility="Collapsed"
                                    Click="RetryButton_Click" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="AuthStatusLabel"
                               Text="Not signed in."
                               Style="{StaticResource StatusText}" />
                </StackPanel>
            </ContentControl>
        </ScrollViewer>
        <TabControl x:Name="MainTabs"
                    Margin="16"
                    Padding="0,20,0,0"
                    Visibility="Collapsed"
                    SelectionChanged="MainTabs_SelectionChanged">
            <TabItem Header="Session">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel VerticalAlignment="Top" Margin="4,0,12,16">
                        <TextBlock Text="Session"
                                   Style="{StaticResource HeadlineText}"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="Character and spot are required. Lists come from the website — this app does not create or edit them."
                                   Style="{StaticResource SubtleText}"
                                   Margin="0,0,0,18" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Character"
                                       Style="{StaticResource FieldLabelText}" />
                            <ComboBox x:Name="CharacterCombo"
                                      Grid.Column="1"
                                      DisplayMemberPath="Name"
                                      IsEnabled="False"
                                      SelectionChanged="CharacterCombo_SelectionChanged" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Spot"
                                       Style="{StaticResource FieldLabelText}" />
                            <ComboBox x:Name="SpotCombo"
                                      Grid.Column="1"
                                      DisplayMemberPath="Label"
                                      IsEnabled="False"
                                      IsEditable="False"
                                      IsTextSearchEnabled="True"
                                      SelectionChanged="SpotCombo_SelectionChanged" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="% Bonus"
                                       Style="{StaticResource FieldLabelText}" />
                            <TextBox x:Name="BonusBox"
                                     Grid.Column="1"
                                     IsEnabled="False" />
                        </Grid>
                        <TextBlock x:Name="BonusHintLabel"
                                   Text=""
                                   Style="{StaticResource MutedText}"
                                   Margin="90,0,0,10"
                                   Visibility="Collapsed" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,26">
                            <Button x:Name="SaveButton"
                                    Content="Save"
                                    Style="{StaticResource PrimaryButton}"
                                    IsEnabled="False"
                                    Click="SaveButton_Click" />
                            <TextBlock x:Name="PickerStatusLabel"
                                       Text="Loading characters…"
                                       Style="{StaticResource StatusText}"
                                       VerticalAlignment="Center"
                                       Margin="14,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="Game window"
                                   Style="{StaticResource TitleText}"
                                   Margin="0,0,0,6" />
                        <TextBlock x:Name="GameWindowStatusLabel"
                                   Text="Checking..."
                                   Style="{StaticResource StatusText}"
                                   Margin="0,0,0,16" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="StartStopButton"
                                    Content="Start tracking"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="StartStopButton_Click" />
                            <Button x:Name="NewSessionButton"
                                    Content="New session"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="10,0,0,0"
                                    Click="NewSessionButton_Click" />
                            <TextBlock x:Name="PollStatusLabel"
                                       Text="Not tracking."
                                       Style="{StaticResource StatusText}"
                                       VerticalAlignment="Center"
                                       Margin="14,0,0,0" />
                        </StackPanel>
                        <Border x:Name="LiveStatusBorder"
                                Margin="0,20,0,0"
                                Style="{StaticResource GlassPanel}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Ellipse x:Name="LiveLight"
                                             Width="14"
                                             Height="14"
                                             Fill="#FF6E7681"
                                             VerticalAlignment="Center" />
                                    <TextBlock x:Name="LiveLightLabel"
                                               Text="Idle"
                                               Style="{StaticResource TitleText}"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="LiveDetailLabel"
                                           Text="No snapshot yet."
                                           Style="{StaticResource SubtleText}"
                                           Margin="0,0,0,12" />
                                <TextBlock x:Name="LiveRatesLabel"
                                           Text=""
                                           Style="{StaticResource TitleText}"
                                           Margin="0,0,0,10" />
                                <TextBlock x:Name="LiveValuesLabel"
                                           Text=""
                                           Style="{StaticResource StatusText}" />
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="DebugToolsPanel"
                                    Visibility="Collapsed">
                            <TextBlock Text="DEBUG TOOLS"
                                       Style="{StaticResource StampText}"
                                       Margin="0,26,0,10" />
                            <Button x:Name="CaptureOnceButton"
                                    Content="Capture once"
                                    Style="{StaticResource SmallSecondaryButton}"
                                    Click="CaptureOnceButton_Click" />
                            <TextBlock x:Name="CaptureStatusLabel"
                                       Text=""
                                       Style="{StaticResource StatusText}"
                                       Margin="0,10,0,16" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ParseLastButton"
                                        Content="Parse last capture"
                                        Style="{StaticResource SmallSecondaryButton}"
                                        Click="ParseLastButton_Click" />
                                <Button x:Name="ParsePngButton"
                                        Content="Parse a PNG..."
                                        Style="{StaticResource SmallSecondaryButton}"
                                        Margin="8,0,0,0"
                                        Click="ParsePngButton_Click" />
                            </StackPanel>
                            <TextBlock x:Name="ParseStatusLabel"
                                       Text=""
                                       Style="{StaticResource StatusText}"
                                       Margin="0,10,0,12" />
                            <TextBlock x:Name="SessionStatusLabel"
                                       Text=""
                                       Style="{StaticResource StatusText}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel VerticalAlignment="Top" Margin="4,0,12,16">
                        <TextBlock Text="Options"
                                   Style="{StaticResource HeadlineText}"
                                   Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton x:Name="UserModeRadio"
                                         Content="User"
                                         VerticalAlignment="Center"
                                         Checked="AppMode_Checked" />
                            <RadioButton x:Name="DebugModeRadio"
                                         Content="Debug"
                                         VerticalAlignment="Center"
                                         Margin="20,0,0,0"
                                         Checked="AppMode_Checked" />
                        </StackPanel>
                        <TextBlock Text="User hides capture dumps, parse tools, and session inspect. Debug shows them for troubleshooting, and reveals the API field on the sign-in screen."
                                   Style="{StaticResource SubtleText}"
                                   Margin="0,0,0,28" />
                        <TextBlock Text="Account"
                                   Style="{StaticResource TitleText}"
                                   Margin="0,0,0,8" />
                        <TextBlock x:Name="AccountStatusLabel"
                                   Text=""
                                   Style="{StaticResource StatusText}"
                                   Margin="0,0,0,14" />
                        <Button x:Name="SignOutButton"
                                Content="Sign out"
                                Style="{StaticResource DangerButton}"
                                Click="SignOutButton_Click" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
