<Window x:Class="L2TrackerCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="L2 Tracker Companion"
        Width="660"
        Height="720"
        MinWidth="560"
        MinHeight="520"
        Background="{StaticResource TerminalBlackBrush}"
        Foreground="{StaticResource SignalWhiteBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="{StaticResource FontSizeBody}"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Sign-in gate: the only view until GET /api/me + /api/characters accept the token. -->
        <ScrollViewer x:Name="LoginView"
                      Grid.Row="0"
                      Grid.RowSpan="2"
                      VerticalScrollBarVisibility="Auto">
            <ContentControl MaxWidth="380"
                            Margin="24,56,24,24"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Center"
                            Style="{StaticResource BeaconPanel}">
                <StackPanel>
                    <TextBlock Text="L2 Tracker Companion"
                               Style="{StaticResource HeadlineText}"
                               Margin="0,0,0,14" />
                    <StackPanel x:Name="GateForm">
                        <TextBlock x:Name="AuthHintLabel"
                                   Text="Paste the token from the website."
                                   Style="{StaticResource SubtleText}"
                                   Margin="0,0,0,12" />
                        <TextBlock Style="{StaticResource SubtleText}"
                                   Margin="0,0,0,12"
                                   TextWrapping="Wrap">
                            Don't have an account yet? Sign up at
                            <Hyperlink NavigateUri="https://l2tracker.cc"
                                       RequestNavigate="WebsiteLink_RequestNavigate">l2tracker.cc</Hyperlink>
                        </TextBlock>
                        <PasswordBox x:Name="TokenBox"
                                     Margin="0,0,0,12"
                                     KeyDown="TokenBox_KeyDown" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,0,14">
                            <Button x:Name="RetryButton"
                                    Content="Retry with stored token"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,8,0"
                                    Visibility="Collapsed"
                                    Click="RetryButton_Click" />
                            <Button x:Name="SignInButton"
                                    Content="Sign in"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="SignInButton_Click" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="AuthStatusLabel"
                               Text=""
                               Visibility="Collapsed"
                               Style="{StaticResource StatusText}" />
                </StackPanel>
            </ContentControl>
        </ScrollViewer>

        <TabControl x:Name="MainTabs"
                    Grid.Row="0"
                    Padding="0,14,0,0"
                    Visibility="Collapsed"
                    SelectionChanged="MainTabs_SelectionChanged">
            <TabItem Header="Session">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="{StaticResource ContentMaxWidth}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="14,4,14,14">
                        <HeaderedContentControl Header="Session"
                                                Style="{StaticResource SectionGroup}">
                            <!-- Every row below shares one label column, so the
                                 hint and the button stay aligned with the fields
                                 without repeating a width anywhere. -->
                            <StackPanel Grid.IsSharedSizeScope="True">
                                <TextBlock Text="Character and spot are required. Lists come from the website — this app does not create or edit them."
                                           Style="{StaticResource SubtleText}"
                                           Margin="0,0,0,10" />
                                <Grid Style="{StaticResource FieldRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="SessionLabel" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Character"
                                               Margin="0,0,12,0"
                                               Style="{StaticResource FieldLabelText}" />
                                    <ComboBox x:Name="CharacterCombo"
                                              Grid.Column="1"
                                              MaxWidth="{StaticResource FieldMaxWidth}"
                                              HorizontalAlignment="Left"
                                              MinWidth="240"
                                              DisplayMemberPath="Name"
                                              IsEnabled="False"
                                              SelectionChanged="CharacterCombo_SelectionChanged" />
                                </Grid>
                                <Grid Style="{StaticResource FieldRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="SessionLabel" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Spot"
                                               Margin="0,0,12,0"
                                               Style="{StaticResource FieldLabelText}" />
                                    <ComboBox x:Name="SpotCombo"
                                              Grid.Column="1"
                                              MaxWidth="{StaticResource FieldMaxWidth}"
                                              HorizontalAlignment="Left"
                                              MinWidth="240"
                                              DisplayMemberPath="Label"
                                              IsEnabled="False"
                                              IsEditable="False"
                                              IsTextSearchEnabled="True"
                                              SelectionChanged="SpotCombo_SelectionChanged" />
                                </Grid>
                                <Grid Style="{StaticResource FieldRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="SessionLabel" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="% Bonus"
                                               Margin="0,0,12,0"
                                               Style="{StaticResource FieldLabelText}" />
                                    <TextBox x:Name="BonusBox"
                                             Grid.Column="1"
                                             Width="90"
                                             HorizontalAlignment="Left"
                                             IsEnabled="False" />
                                </Grid>
                                <Grid x:Name="BonusHintLabelRow"
                                      Style="{StaticResource FieldRow}"
                                      Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="SessionLabel" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="BonusHintLabel"
                                               Grid.Column="1"
                                               Text=""
                                               Style="{StaticResource MutedText}" />
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="SessionLabel" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="SaveButton"
                                            Grid.Column="1"
                                            Content="Save"
                                            Style="{StaticResource PrimaryButton}"
                                            IsEnabled="False"
                                            Click="SaveButton_Click" />
                                </Grid>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Game window"
                                                Style="{StaticResource SectionGroup}">
                            <StackPanel>
                                <TextBlock x:Name="GameWindowStatusLabel"
                                           Text="Checking..."
                                           Style="{StaticResource SubtleText}"
                                           Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="StartStopButton"
                                            Content="Start reading"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="StartStopButton_Click" />
                                    <Button x:Name="NewSessionButton"
                                            Content="New session"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="8,0,0,0"
                                            Click="NewSessionButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Live status"
                                                Style="{StaticResource SectionGroup}">
                            <Border x:Name="LiveStatusBorder"
                                    Style="{StaticResource GlassPanel}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Ellipse x:Name="LiveLight"
                                                 Width="10"
                                                 Height="10"
                                                 Fill="{StaticResource IdleGrayBrush}"
                                                 VerticalAlignment="Center" />
                                        <TextBlock x:Name="LiveDetailLabel"
                                                   Text="No snapshot yet."
                                                   Style="{StaticResource TitleText}"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="LiveRatesLabel"
                                               Text=""
                                               Style="{StaticResource TitleText}"
                                               Margin="0,0,0,6" />
                                    <TextBlock x:Name="LiveValuesLabel"
                                               Text=""
                                               Style="{StaticResource StatusText}" />
                                </StackPanel>
                            </Border>
                        </HeaderedContentControl>

                        <StackPanel x:Name="DebugToolsPanel"
                                    Visibility="Collapsed">
                            <HeaderedContentControl Header="Debug tools"
                                                    Style="{StaticResource SectionGroup}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="CaptureOnceButton"
                                                Content="Capture once"
                                                Style="{StaticResource SmallSecondaryButton}"
                                                Click="CaptureOnceButton_Click" />
                                        <Button x:Name="ParseLastButton"
                                                Content="Parse last capture"
                                                Style="{StaticResource SmallSecondaryButton}"
                                                Margin="6,0,0,0"
                                                Click="ParseLastButton_Click" />
                                        <Button x:Name="ParsePngButton"
                                                Content="Parse a PNG..."
                                                Style="{StaticResource SmallSecondaryButton}"
                                                Margin="6,0,0,0"
                                                Click="ParsePngButton_Click" />
                                    </StackPanel>
                                    <TextBlock x:Name="CaptureStatusLabel"
                                               Text=""
                                               Style="{StaticResource StatusText}"
                                               Margin="0,10,0,0" />
                                    <TextBlock x:Name="ParseStatusLabel"
                                               Text=""
                                               Style="{StaticResource StatusText}"
                                               Margin="0,10,0,0" />
                                    <TextBlock x:Name="SessionStatusLabel"
                                               Text=""
                                               Style="{StaticResource StatusText}"
                                               Margin="0,10,0,0" />
                                </StackPanel>
                            </HeaderedContentControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="{StaticResource ContentMaxWidth}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="14,4,14,14">
                        <HeaderedContentControl x:Name="OptionsSection"
                                                Header="Options"
                                                Style="{StaticResource SectionGroup}"
                                                Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <RadioButton x:Name="UserModeRadio"
                                                 Content="User"
                                                 VerticalAlignment="Center"
                                                 Checked="AppMode_Checked" />
                                    <RadioButton x:Name="DebugModeRadio"
                                                 Content="Debug"
                                                 VerticalAlignment="Center"
                                                 Margin="18,0,0,0"
                                                 Checked="AppMode_Checked" />
                                </StackPanel>
                                <TextBlock Text="User hides capture dumps, parse tools, and session inspect. Debug shows them for troubleshooting."
                                           Style="{StaticResource SubtleText}" />
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Account"
                                                Style="{StaticResource SectionGroup}">
                            <StackPanel>
                                <TextBlock x:Name="AccountStatusLabel"
                                           Text=""
                                           Style="{StaticResource StatusText}"
                                           Margin="0,0,0,10" />
                                <Button x:Name="SignOutButton"
                                        Content="Sign out"
                                        Style="{StaticResource DangerButton}"
                                        Click="SignOutButton_Click" />
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="About"
                                                Style="{StaticResource SectionGroup}">
                            <TextBlock x:Name="AppVersionLabel"
                                       Text=""
                                       Style="{StaticResource SubtleText}" />
                        </HeaderedContentControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Status bar: where a desktop app puts the running commentary, instead
             of parking it beside the button that caused it. -->
        <Border x:Name="StatusBar"
                Grid.Row="1"
                Style="{StaticResource StatusBarBorder}"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <!-- Capped: RefreshPollStatus can write a whole sentence (a
                         game restart, or "Tick failed: {ex.Message}"), and an
                         uncapped Auto column would trim the save status beside
                         it down to an ellipsis. -->
                    <ColumnDefinition Width="Auto" MaxWidth="260" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PickerStatusLabel"
                           Text="Loading characters…"
                           Style="{StaticResource StatusBarText}" />
                <!-- Content is set in code-behind (CheckForUpdatesAsync) with the
                     found version number before Visibility ever flips to Visible. -->
                <Button x:Name="UpdateAvailableButton"
                        Grid.Column="1"
                        Style="{StaticResource SmallSecondaryButton}"
                        Margin="16,0,0,0"
                        Visibility="Collapsed"
                        Click="UpdateAvailableButton_Click" />
                <TextBlock x:Name="PollStatusLabel"
                           Grid.Column="2"
                           Text="Not tracking."
                           Style="{StaticResource StatusBarText}"
                           Margin="16,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>
