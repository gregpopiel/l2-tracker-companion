<Window x:Class="L2TrackerCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="L2 Tracker Companion"
        Height="450"
        Width="800">
    <Grid Margin="16">
        <StackPanel VerticalAlignment="Top">
            <TextBlock Text="Game window"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />
            <TextBlock x:Name="GameWindowStatusLabel"
                       Text="Checking..."
                       TextWrapping="Wrap"
                       FontFamily="Consolas"
                       FontSize="13"
                       Margin="0,0,0,16" />
            <Button x:Name="CaptureOnceButton"
                    Content="Capture once"
                    Padding="12,6"
                    HorizontalAlignment="Left"
                    Click="CaptureOnceButton_Click" />
            <TextBlock x:Name="CaptureStatusLabel"
                       Text=""
                       TextWrapping="Wrap"
                       FontFamily="Consolas"
                       FontSize="13"
                       Margin="0,12,0,0" />
        </StackPanel>
    </Grid>
</Window>
