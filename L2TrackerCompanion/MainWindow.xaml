<Window x:Class="L2TrackerCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="L2 Tracker Companion"
        Width="480"
        Height="720"
        MinWidth="480"
        MaxWidth="480"
        MinHeight="520"
        Background="{StaticResource TerminalBlackBrush}"
        Foreground="{StaticResource SignalWhiteBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="{StaticResource FontSizeBody}"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Sign-in gate: the only view until GET /api/me + /api/characters accept the token. -->
        <ScrollViewer x:Name="LoginView"
                      Grid.Row="0"
                      Grid.RowSpan="2"
                      VerticalScrollBarVisibility="Hidden">
            <ContentControl MaxWidth="380"
                            Margin="24,56,24,24"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Center"
                            Style="{StaticResource BeaconPanel}">
                <StackPanel>
                    <TextBlock Text="L2 Tracker Companion"
                               Style="{StaticResource HeadlineText}"
                               Margin="0,0,0,14" />
                    <StackPanel x:Name="GateForm">
                        <TextBlock x:Name="AuthHintLabel"
                                   Text="Paste the token from the website."
                                   Style="{StaticResource SubtleText}"
                                   Margin="0,0,0,12" />
                        <TextBlock Style="{StaticResource SubtleText}"
                                   Margin="0,0,0,12"
                                   TextWrapping="Wrap">
                            Don't have an account yet? Sign up at
                            <Hyperlink NavigateUri="https://l2tracker.cc"
                                       RequestNavigate="WebsiteLink_RequestNavigate">l2tracker.cc</Hyperlink>
                        </TextBlock>
                        <PasswordBox x:Name="TokenBox"
                                     Margin="0,0,0,12"
                                     KeyDown="TokenBox_KeyDown" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,0,14">
                            <Button x:Name="RetryButton"
                                    Content="Retry with stored token"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,8,0"
                                    Visibility="Collapsed"
                                    Click="RetryButton_Click" />
                            <Button x:Name="SignInButton"
                                    Content="Sign in"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="SignInButton_Click" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="AuthStatusLabel"
                               Text=""
                               Visibility="Collapsed"
                               Style="{StaticResource StatusText}" />
                </StackPanel>
            </ContentControl>
        </ScrollViewer>

        <TabControl x:Name="MainTabs"
                    Grid.Row="0"
                    Padding="0,6,0,0"
                    Visibility="Collapsed"
                    SelectionChanged="MainTabs_SelectionChanged">
            <TabItem Header="Session">
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <StackPanel VerticalAlignment="Top"
                                Margin="20,6,20,14">

                        <!-- General row: no card, no borders — a thin strip of
                             meta fields under the tabs, per the handoff. Three
                             equal columns, same full-width rhythm as the
                             totals/lamps rows below, instead of packing left. -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Plain Foreground, not the SubtleText style: that
                                 style's LineHeight="21" (fine at its usual sizes)
                                 forces every label here taller than the flat
                                 ComboBox/TextBox next to it, throwing off the
                                 row's vertical centering. -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Character:"
                                           FontSize="{StaticResource FontSizeXs}"
                                           Foreground="{StaticResource StaticGrayBrush}"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center" />
                                <!-- Capped narrow to keep the row thin, so a
                                     long name does not fit the closed picker:
                                     the tooltip is how it stays readable. -->
                                <ComboBox x:Name="CharacterCombo"
                                          Style="{StaticResource FlatComboBox}"
                                          FontSize="{StaticResource FontSizeXs}"
                                          Foreground="{StaticResource SignalWhiteBrush}"
                                          MaxWidth="70"
                                          VerticalAlignment="Center"
                                          DisplayMemberPath="Name"
                                          IsEnabled="False"
                                          ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}"
                                          SelectionChanged="CharacterCombo_SelectionChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="Bonus:"
                                           FontSize="{StaticResource FontSizeXs}"
                                           Foreground="{StaticResource StaticGrayBrush}"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center" />
                                <TextBox x:Name="BonusBox"
                                         Style="{StaticResource UnderlineTextBox}"
                                         FontSize="{StaticResource FontSizeXs}"
                                         Foreground="{StaticResource SignalWhiteBrush}"
                                         Width="34"
                                         VerticalAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         IsEnabled="False" />
                                <TextBlock Text="%"
                                           FontSize="{StaticResource FontSizeXs}"
                                           Foreground="{StaticResource StaticGrayBrush}"
                                           Margin="2,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <TextBlock Text="Ranking:"
                                           FontSize="{StaticResource FontSizeXs}"
                                           Foreground="{StaticResource StaticGrayBrush}"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center" />
                                <!-- Same fixed-width trade-off as the character
                                     picker: "Special Zone" does not fit, so the
                                     tooltip carries the full area name. -->
                                <ComboBox x:Name="AreaFilterCombo"
                                          Style="{StaticResource FlatComboBox}"
                                          FontSize="{StaticResource FontSizeXs}"
                                          Foreground="{StaticResource SignalWhiteBrush}"
                                          MinWidth="70"
                                          MaxWidth="70"
                                          VerticalAlignment="Center"
                                          DisplayMemberPath="Label"
                                          IsEditable="False"
                                          ToolTip="{Binding SelectedItem.Label, RelativeSource={RelativeSource Self}}"
                                          SelectionChanged="AreaFilterCombo_SelectionChanged" />
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="BonusHintLabelRow"
                              Margin="0,-8,0,10"
                              Visibility="Collapsed">
                            <TextBlock x:Name="BonusHintLabel"
                                       Text=""
                                       Style="{StaticResource MutedText}" />
                        </Grid>

                        <Border Height="1"
                                Background="{StaticResource HairlineBrush}"
                                Margin="0,0,0,8" />

                        <!-- Save readiness / error commentary: not part of the
                             handoff's fixed layout, kept here (rather than
                             dropped) so the detailed reasons RefreshSaveEnabled
                             already produces ("Ready to save…", "Could not
                             load spots: …") stay visible somewhere. -->
                        <!-- Plain Foreground, not the SubtleText style: that
                             style's LineHeight="21" left an oversized gap
                             before the card below, the same issue fixed
                             earlier in the general row. -->
                        <!-- Always rendered, never Visibility-toggled: this
                             text changes often during startup (character/
                             spot loads firing in quick succession), and a
                             collapse-on-empty style here made everything
                             below it visibly jump/flicker as it happened. A
                             small constant reserved line is the trade-off. -->
                        <TextBlock x:Name="PickerStatusLabel"
                                   Text="Loading characters…"
                                   FontSize="{StaticResource FontSizeXs}"
                                   Foreground="{StaticResource StaticGrayBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,4" />

                        <!-- Alerts: at most two, location first — pure
                             top-of-content banners, so appearing/disappearing
                             never shifts anything below. -->
                        <Border x:Name="LocationChangeBanner"
                                Style="{StaticResource AlertBanner}"
                                Visibility="Collapsed">
                            <TextBlock x:Name="LocationChangeLabel"
                                       Text=""
                                       Style="{StaticResource AlertBannerText}" />
                        </Border>
                        <Border x:Name="ReadProblemBanner"
                                Style="{StaticResource AlertBanner}"
                                Visibility="Collapsed">
                            <TextBlock x:Name="ReadProblemLabel"
                                       Text=""
                                       Style="{StaticResource AlertBannerText}" />
                        </Border>

                        <!-- Rate & ranking card. -->
                        <Border x:Name="LiveStatusBorder"
                                Style="{StaticResource GlassPanel}"
                                Padding="16,14"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel HorizontalAlignment="Center">
                                        <Border x:Name="XpRankBadge"
                                                Style="{StaticResource RankBadge}"
                                                Margin="0,0,0,8"
                                                Visibility="Collapsed">
                                            <TextBlock x:Name="XpRankBadgeLabel"
                                                       Text=""
                                                       Style="{StaticResource RankBadgeText}" />
                                        </Border>
                                        <TextBlock x:Name="XpPerHourValue"
                                                   Text="0"
                                                   Style="{StaticResource BigNumberText}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="XP/h"
                                                   Style="{StaticResource SubtleText}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                HorizontalAlignment="Center">
                                        <Border x:Name="AdenaRankBadge"
                                                Style="{StaticResource RankBadge}"
                                                Margin="0,0,0,8"
                                                Visibility="Collapsed">
                                            <TextBlock x:Name="AdenaRankBadgeLabel"
                                                       Text=""
                                                       Style="{StaticResource RankBadgeText}" />
                                        </Border>
                                        <TextBlock x:Name="AdenaPerHourValue"
                                                   Text="0"
                                                   Style="{StaticResource BigNumberText}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="Adena/h"
                                                   Style="{StaticResource SubtleText}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Session totals. -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="SessionXpValue"
                                           Text="0"
                                           FontSize="{StaticResource FontSizeHeadline}"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource SignalWhiteBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="XP"
                                           FontSize="{StaticResource FontSizeXs}"
                                           Style="{StaticResource SubtleText}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Center">
                                <TextBlock x:Name="SessionAdenaValue"
                                           Text="0"
                                           FontSize="{StaticResource FontSizeHeadline}"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource SignalWhiteBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Adena"
                                           FontSize="{StaticResource FontSizeXs}"
                                           Style="{StaticResource SubtleText}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="2"
                                        HorizontalAlignment="Center">
                                <TextBlock x:Name="SessionPlayTimeValue"
                                           Text="0 min"
                                           FontSize="{StaticResource FontSizeHeadline}"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource SignalWhiteBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Play time"
                                           FontSize="{StaticResource FontSizeXs}"
                                           Style="{StaticResource SubtleText}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1"
                                Background="{StaticResource HairlineBrush}"
                                Margin="0,0,0,14" />

                        <!-- Lamps. -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Red Lantern"
                                           FontSize="{StaticResource FontSizeLabel}"
                                           Foreground="{StaticResource StaticGrayBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="RedLampValue"
                                           Text="0"
                                           FontSize="{StaticResource FontSizeLabel}"
                                           Foreground="{StaticResource StaticGrayBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="Purple Lantern"
                                           FontSize="{StaticResource FontSizeLabel}"
                                           Foreground="{StaticResource StaticGrayBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="PurpleLampValue"
                                           Text="0"
                                           FontSize="{StaticResource FontSizeLabel}"
                                           Foreground="{StaticResource StaticGrayBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="2"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="Blue Lantern"
                                           FontSize="{StaticResource FontSizeLabel}"
                                           Foreground="{StaticResource StaticGrayBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="BlueLampValue"
                                           Text="0"
                                           FontSize="{StaticResource FontSizeLabel}"
                                           Foreground="{StaticResource StaticGrayBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="3"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="Green Lantern"
                                           FontSize="{StaticResource FontSizeLabel}"
                                           Foreground="{StaticResource StaticGrayBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="GreenLampValue"
                                           Text="0"
                                           FontSize="{StaticResource FontSizeLabel}"
                                           Foreground="{StaticResource StaticGrayBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- Spot: full width, no label above. -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="SpotCombo"
                                      FontSize="{StaticResource FontSizeField}"
                                      MinHeight="40"
                                      HorizontalAlignment="Stretch"
                                      DisplayMemberPath="Label"
                                      IsEnabled="False"
                                      IsEditable="False"
                                      IsTextSearchEnabled="True"
                                      SelectionChanged="SpotCombo_SelectionChanged" />
                            <Button x:Name="ClearSpotButton"
                                    Grid.Column="1"
                                    Content="Clear"
                                    Style="{StaticResource SmallSecondaryButton}"
                                    FontSize="{StaticResource FontSizeBody}"
                                    MinHeight="40"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Stretch"
                                    IsEnabled="False"
                                    Click="ClearSpotButton_Click" />
                        </Grid>
                        <Grid x:Name="SpotResolveHintRow"
                              Margin="0,0,0,14"
                              Visibility="Collapsed">
                            <TextBlock x:Name="SpotResolveHintLabel"
                                       Text=""
                                       TextWrapping="Wrap"
                                       FontSize="{StaticResource FontSizeXs}"
                                       Style="{StaticResource SubtleText}" />
                        </Grid>

                        <!-- One action button doing double duty: "Start
                             tracking" with nothing to save, "Save & send
                             session" once tracking is on or there's a held
                             frame from an earlier Stop — see
                             MainActionButton_Click/RefreshSaveEnabled. -->
                        <Button x:Name="MainActionButton"
                                Content="Start tracking"
                                Style="{StaticResource PrimaryButton}"
                                FontSize="{StaticResource FontSizeButtonLg}"
                                FontWeight="Bold"
                                Height="{StaticResource PrimaryActionHeight}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Margin="0,0,0,4"
                                Click="MainActionButton_Click" />
                        <!-- The escape hatch for the merged button above:
                             "Stop tracking" while a run is on, and once
                             stopped with a frame still held, "Start a new
                             session" — otherwise Save (which an unresolvable
                             spot can block outright) would be the only way
                             out and a fresh run unreachable. Content and
                             visibility are set in RefreshSaveEnabled. -->
                        <Button x:Name="SecondaryActionLink"
                                Content="Stop tracking"
                                Style="{StaticResource LinkButton}"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,8"
                                Visibility="Collapsed"
                                Click="SecondaryActionLink_Click" />

                        <StackPanel x:Name="DebugToolsPanel"
                                    Visibility="Collapsed">
                            <HeaderedContentControl Header="Debug tools"
                                                    Style="{StaticResource SectionGroup}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="CaptureOnceButton"
                                                Content="Capture once"
                                                Style="{StaticResource SmallSecondaryButton}"
                                                Click="CaptureOnceButton_Click" />
                                        <Button x:Name="ParseLastButton"
                                                Content="Parse last capture"
                                                Style="{StaticResource SmallSecondaryButton}"
                                                Margin="6,0,0,0"
                                                Click="ParseLastButton_Click" />
                                        <Button x:Name="ParsePngButton"
                                                Content="Parse a PNG..."
                                                Style="{StaticResource SmallSecondaryButton}"
                                                Margin="6,0,0,0"
                                                Click="ParsePngButton_Click" />
                                    </StackPanel>
                                    <TextBlock x:Name="CaptureStatusLabel"
                                               Text=""
                                               Style="{StaticResource StatusText}"
                                               Margin="0,10,0,0" />
                                    <TextBlock x:Name="ParseStatusLabel"
                                               Text=""
                                               Style="{StaticResource StatusText}"
                                               Margin="0,10,0,0" />
                                    <TextBlock x:Name="SessionStatusLabel"
                                               Text=""
                                               Style="{StaticResource StatusText}"
                                               Margin="0,10,0,0" />
                                    <!-- The raw read the redesigned card no
                                         longer spells out (XP / Adena / play
                                         time / lamps / location). Lives here so
                                         DebugToolsPanel's own visibility is
                                         what shows it. -->
                                    <TextBlock x:Name="LiveValuesLabel"
                                               Text=""
                                               Style="{StaticResource StatusText}"
                                               Margin="0,10,0,0" />
                                </StackPanel>
                            </HeaderedContentControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <StackPanel MaxWidth="{StaticResource ContentMaxWidth}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="14,4,14,14">
                        <HeaderedContentControl x:Name="OptionsSection"
                                                Header="Options"
                                                Style="{StaticResource SectionGroup}"
                                                Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <RadioButton x:Name="UserModeRadio"
                                                 Content="User"
                                                 VerticalAlignment="Center"
                                                 Checked="AppMode_Checked" />
                                    <RadioButton x:Name="DebugModeRadio"
                                                 Content="Debug"
                                                 VerticalAlignment="Center"
                                                 Margin="18,0,0,0"
                                                 Checked="AppMode_Checked" />
                                </StackPanel>
                                <TextBlock Text="User hides capture dumps, parse tools, and session inspect. Debug shows them for troubleshooting."
                                           Style="{StaticResource SubtleText}" />
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Account"
                                                Style="{StaticResource SectionGroup}">
                            <StackPanel>
                                <TextBlock x:Name="AccountStatusLabel"
                                           Text=""
                                           Style="{StaticResource StatusText}"
                                           Margin="0,0,0,10" />
                                <Button x:Name="SignOutButton"
                                        Content="Sign out"
                                        Style="{StaticResource DangerButton}"
                                        Click="SignOutButton_Click" />
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="About"
                                                Style="{StaticResource SectionGroup}">
                            <TextBlock x:Name="AppVersionLabel"
                                       Text=""
                                       Style="{StaticResource SubtleText}" />
                        </HeaderedContentControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Status bar: where a desktop app puts the running commentary, instead
             of parking it beside the button that caused it. -->
        <Border x:Name="StatusBar"
                Grid.Row="1"
                Style="{StaticResource StatusBarBorder}"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <!-- Capped: RefreshPollStatus can write a whole sentence (a
                         game restart, or "Tick failed: {ex.Message}"), and an
                         uncapped Auto column would trim the save status beside
                         it down to an ellipsis. -->
                    <ColumnDefinition Width="Auto" MaxWidth="260" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="GameWindowStatusLabel"
                           Text="Checking..."
                           FontSize="{StaticResource FontSizeXs}"
                           Style="{StaticResource StatusBarText}" />
                <!-- Content is set in code-behind (CheckForUpdatesAsync) with the
                     found version number before Visibility ever flips to Visible. -->
                <Button x:Name="UpdateAvailableButton"
                        Grid.Column="1"
                        Style="{StaticResource SmallSecondaryButton}"
                        Margin="16,0,0,0"
                        Visibility="Collapsed"
                        Click="UpdateAvailableButton_Click" />
                <TextBlock x:Name="PollStatusLabel"
                           Grid.Column="2"
                           Text="Not tracking."
                           FontSize="{StaticResource FontSizeXs}"
                           Style="{StaticResource StatusBarText}"
                           Margin="16,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>
